FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MIR_DEPLOYMENT=railway HOST=0.0.0.0
COPY ["서버/requirements.txt", "./requirements.txt"]
COPY ["서버/requirements-integrated-tested.txt", "./constraints.txt"]
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt
COPY ["서버/app/", "./app/"]
COPY ["서버/config/research-sources.json", "./config/research-sources.json"]
COPY ["서버/config/prompts/", "./config/prompts/"]
COPY ["서버/static/", "./static/"]
COPY ["서버/parts/", "./parts/"]
COPY ["서버/run.py", "./run.py"]
CMD ["python", "run.py"]
