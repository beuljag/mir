FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY entry.js ./
COPY scripts/build-web.cjs ./scripts/build-web.cjs
COPY assets ./assets
COPY docs ./docs
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production MIR_DEPLOYMENT=railway HOST=0.0.0.0
COPY package.json serve.cjs runtime-config.cjs mir-version.json ./
COPY ["미르 HTML.html", "미르.css", "./"]
COPY --from=build /app/미르.js ./미르.js
COPY --from=build /app/assets ./assets
COPY --from=build /app/docs ./docs
COPY ["서버/parts/", "./서버/parts/"]
CMD ["node", "serve.cjs"]
