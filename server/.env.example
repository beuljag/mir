# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 큰따옴표 없이 바로 넣으세요.
# 호스팅 서비스를 쓰면 .env 대신 그 서비스의 "환경 변수" 화면에 같은 이름으로 넣으면 됩니다.

# (필수) Copilot Studio > 설정 > 보안 > 웹 채널 보안 의 비밀 키
COPILOT_DIRECT_LINE_SECRET=

# (선택) 서버 포트. 호스팅 서비스가 정해 주면 비워 두세요. 기본 3000
PORT=

# (선택) Direct Line 주소. 보통은 비워 두면 됩니다. 기본 https://directline.botframework.com
DIRECT_LINE_DOMAIN=

# (선택) 한 IP가 1분에 받을 수 있는 토큰 수. 기본 10
RATE_LIMIT_PER_MIN=
