  "components": {
    "schemas": {
      "ApplyRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "allow_unvalidated_draft": {
            "type": "boolean",
            "title": "Allow Unvalidated Draft",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "ApplyRequest"
      },
      "ApplyResult": {
        "properties": {
          "circuit_id": {
            "type": "string",
            "title": "Circuit Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "editor_url": {
            "type": "string",
            "title": "Editor Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "circuit_id",
          "version",
          "status",
          "editor_url"
        ],
        "title": "ApplyResult"
      },
      "CandidateRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          },
          "requested_model": {
            "type": "string",
            "title": "Requested Model"
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "approved",
              "rejected"
            ],
            "title": "Status",
            "default": "pending_review"
          },
          "analyses": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Analyses"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "review": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "job_id",
          "requested_model",
          "analyses"
        ],
        "title": "CandidateRecord"
      },
      "CircuitDraft": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "requirements": {
            "type": "string",
            "maxLength": 10000,
            "title": "Requirements",
            "default": ""
          },
          "component_instances": {
            "items": {
              "$ref": "#/components/schemas/ComponentInstance"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Component Instances"
          },
          "nets": {
            "items": {
              "$ref": "#/components/schemas/Net"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Nets"
          },
          "layout": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Layout"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "component_instances"
        ],
        "title": "CircuitDraft"
      },
      "CircuitRecord": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "requirements": {
            "type": "string",
            "maxLength": 10000,
            "title": "Requirements",
            "default": ""
          },
          "component_instances": {
            "items": {
              "$ref": "#/components/schemas/ComponentInstance"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Component Instances"
          },
          "nets": {
            "items": {
              "$ref": "#/components/schemas/Net"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Nets"
          },
          "layout": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Layout"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "passed",
              "failed",
              "unknown"
            ],
            "title": "Status",
            "default": "draft"
          },
          "validation_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "applied_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "component_instances",
          "id",
          "version"
        ],
        "title": "CircuitRecord"
      },
      "CircuitUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "requirements": {
            "type": "string",
            "maxLength": 10000,
            "title": "Requirements",
            "default": ""
          },
          "component_instances": {
            "items": {
              "$ref": "#/components/schemas/ComponentInstance"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Component Instances"
          },
          "nets": {
            "items": {
              "$ref": "#/components/schemas/Net"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Nets"
          },
          "layout": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Layout"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "component_instances",
          "expected_version"
        ],
        "title": "CircuitUpdate"
      },
      "ComponentDefinition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "manufacturer": {
            "type": "string",
            "title": "Manufacturer"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
