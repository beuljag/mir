# Copilot Studio > Settings > Security > Web channel security > Secret 1 or Secret 2
# Paste the Direct Line secret after =. Do not paste the Circuit API key here.
COPILOT_DIRECT_LINE_SECRET=

# Use the regional Direct Line endpoint if your agent requires it.
COPILOT_DIRECT_LINE_DOMAIN=https://directline.botframework.com/v3/directline

# directline = local server proxy; web = keep the hosted Microsoft chat option
COPILOT_CHAT_MODE=directline

# Local wiring API credentials. Existing keys are migrated without changing them.
CIRCUIT_API_KEY=
CIRCUIT_API_OWNER=local-user

# Human review only; never passed to agents or the local automatic connection.
CIRCUIT_REVIEW_KEY=

# Team SVG prompt -> OpenAI Responses API. Separate from Copilot Direct Line.
OPENAI_API_KEY=
COMPONENT_IMAGE_MODEL=gpt-5-mini

# Optional server-side web search. Copilot built-in web search can also supply source_urls.
BRAVE_SEARCH_API_KEY=

# Imported KiCad schematic verification (local installed executables).
KICAD_CLI_PATH=
NGSPICE_PATH=

# Reply wait for research / component creation (30..900 seconds)
COPILOT_REPLY_TIMEOUT_SECONDS=300
