{
  "name": "mir",
  "productName": "미르",
  "version": "0.1.0",
  "description": "임베디드 입문자를 위한 배선 추천 · 2D 가상 실습 · 오류 진단 (Copilot Studio 에이전트 연동)",
  "main": "main.js",
  "author": "PLAYLABS (아산스마트팩토리마이스터고)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "kr.playlabs.mir",
    "files": ["main.js", "preload.js", "app-config.json", "src/**", "renderer/**", "parts/**", "docs/**", "build/icon.*"],
    "extraResources": [{ "from": "parts", "to": "parts" }],
    "win": { "target": "portable", "icon": "build/icon.ico" }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
